---
import { SITE } from '../consts';
import { url } from '../lib/url';
import LightBeams from '../components/LightBeams.astro';
import SearchBox from '../components/SearchBox.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  current?: string;
  wide?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  current = '',
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const nav = [
  { href: url('/'), label: '首页', key: 'home', d: 'M3 10.6 12 3.4l9 7.2M5.6 9.4V20h12.8V9.4' },
  { href: url('/tags/'), label: '标签', key: 'tags', d: 'M3.5 11.6V4.2h7.4l9.4 9.4-7.4 7.4-9.4-9.4ZM7.6 7.6h.01' },
  { href: url('/docs/'), label: '文档', key: 'docs', d: 'M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5v-13Z' },
  { href: url('/about/'), label: '关于', key: 'about', d: 'M12 11.4a3.3 3.3 0 1 0 0-6.6 3.3 3.3 0 0 0 0 6.6ZM4.8 20c1.4-3.4 4-5 7.2-5s5.8 1.6 7.2 5' },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f180f" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={url('/rss.xml')}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <LightBeams />

    <div class:list={['shell', wide && 'shell-wide']}>
      <header class="topbar">
        <span class="topbar-spacer" aria-hidden="true"></span>

        <nav class="topnav">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={current === item.key ? 'page' : undefined}
              >
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={item.d} />
                </svg>
                <span>{item.label}</span>
              </a>
            ))
          }
        </nav>

        <SearchBox />
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span class="foot-brand">{SITE.title}</span>
        <span class="foot-links">
          <a href={`https://github.com/${SITE.github}`}>GitHub</a>
          <span class="dot">·</span>
          <span>© {new Date().getFullYear()}</span>
        </span>
      </footer>
    </div>
  </body>
</html>
