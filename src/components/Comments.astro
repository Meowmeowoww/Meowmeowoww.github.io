---
// 基于 giscus 的留言/评论：内容存在仓库的 GitHub Discussions 里，静态站不用后端。
//
// 一次性准备（只需做一次）：
//   1. 仓库开启 Discussions（已经开好了）
//   2. 给仓库安装 giscus app：https://github.com/apps/giscus
//      不装的话，组件会显示 “giscus is not installed on this repository”
//
// 每次页面加载（包括 ClientRouter 的客户端切换）都要重新注入脚本，
// 因为换页时 DOM 会被替换，注入的 <script> 不会自动执行。
---
<div class="comments">
  <div class="giscus" data-giscus-host></div>
  <p class="comments-fallback" data-giscus-fallback hidden>
    评论区没加载出来，多半是网络问题。
    <a
      href="https://github.com/Meowmeowoww/Meowmeowoww.github.io/discussions"
      target="_blank"
      rel="noopener">可以直接去 GitHub 上留言 →</a
    >
  </p>
</div>

<script>
  const CFG: Record<string, string> = {
    'data-repo': 'Meowmeowoww/Meowmeowoww.github.io',
    'data-repo-id': 'R_kgDOVlSlCw',
    'data-category': 'General',
    'data-category-id': 'DIC_kwDOVlSlC84DKjg7',
    'data-mapping': 'pathname',
    'data-strict': '0',
    'data-reactions-enabled': '1',
    'data-emit-metadata': '0',
    'data-input-position': 'top',
    'data-theme': 'transparent_dark',
    'data-lang': 'zh-CN',
    'data-loading': 'lazy',
  };

  function mountGiscus() {
    for (const host of Array.from(document.querySelectorAll<HTMLElement>('.giscus[data-giscus-host]'))) {
      if (host.dataset.loaded === '1' || !host.parentElement) continue;
      host.dataset.loaded = '1';

      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      for (const [key, value] of Object.entries(CFG)) script.setAttribute(key, value);

      host.parentElement.appendChild(script);

      // giscus.app 在国内偶尔解析不出来，5 秒还没挂上 iframe 就给个兜底入口
      window.setTimeout(() => {
        if (host.isConnected && !host.querySelector('iframe')) {
          host.parentElement?.querySelector<HTMLElement>('[data-giscus-fallback]')?.removeAttribute('hidden');
        }
      }, 5000);
    }
  }

  mountGiscus();
  document.addEventListener('astro:page-load', mountGiscus);
</script>
