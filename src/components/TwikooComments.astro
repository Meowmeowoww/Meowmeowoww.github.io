---
// Twikoo 评论：不用登录，填昵称和邮箱就能评；数据存在 Netlify 函数 + MongoDB Atlas 里。
// env 就是云函数的完整地址，Twikoo 靠它找到后端。
const TWIKOO_ENV =
  (import.meta.env.PUBLIC_TWIKOO_ENV as string | undefined) ??
  'https://relaxed-moonbeam-42243b.netlify.app/.netlify/functions/twikoo';
---
<div class="comments" data-twikoo-root data-env={TWIKOO_ENV}>
  <div class="twikoo"></div>
  <p class="comments-fallback" data-twikoo-fallback hidden>
    评论加载失败，可能是网络问题。稍后刷新试试。
  </p>
</div>

<script>
  // 国内优先用 npmmirror，失败了再退到 jsdelivr / unpkg
  // 版本要和云函数里的 twikoo-func 保持同一大版本
  const VERSION = '2.0.17';
  const CDNS = [
    `https://registry.npmmirror.com/twikoo/${VERSION}/files/dist/twikoo.min.js`,
    `https://cdn.jsdelivr.net/npm/twikoo@${VERSION}/dist/twikoo.min.js`,
    `https://unpkg.com/twikoo@${VERSION}/dist/twikoo.min.js`,
  ];

  async function loadTwikoo(): Promise<any> {
    if ((window as any).twikoo) return (window as any).twikoo;

    for (const src of CDNS) {
      try {
        await new Promise<void>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = src;
          script.async = true;
          script.onload = () => resolve();
          script.onerror = () => {
            script.remove();
            reject(new Error(src));
          };
          document.head.appendChild(script);
        });
        if ((window as any).twikoo) return (window as any).twikoo;
      } catch {
        // 换下一个 CDN
      }
    }
    return null;
  }

  async function mountTwikoo() {
    const root = document.querySelector<HTMLElement>('[data-twikoo-root]');
    if (!root || root.dataset.loaded === '1') return;

    const env = root.dataset.env;
    if (!env) return; // 还没配置就什么都不做

    root.dataset.loaded = '1';

    const el = root.querySelector<HTMLElement>('.twikoo');
    const fallback = root.querySelector<HTMLElement>('[data-twikoo-fallback]');
    if (!el) return;

    const twikoo = await loadTwikoo();
    if (!twikoo) {
      fallback?.removeAttribute('hidden');
      return;
    }

    try {
      await twikoo.init({ env, el, lang: 'zh-CN' });
    } catch {
      fallback?.removeAttribute('hidden');
    }
  }

  mountTwikoo();
  document.addEventListener('astro:page-load', mountTwikoo);
</script>
