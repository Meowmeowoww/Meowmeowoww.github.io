---
// 背景三层：图片（压暗）→ 渐变蒙版 → 四道光束。
// 光束机制参考 laplace.live：200px 宽的固定容器 + 旋转的长条渐变 + blur，
// 鼠标移动时按 data-depth 做视差。这里是重写的实现，没有引入 parallax 库。
---
<div class="bg" aria-hidden="true"></div>
<div class="bg-grad" aria-hidden="true"></div>

<div class="lights" data-depth="0.2" aria-hidden="true"><div class="light"></div></div>
<div class="lights" data-depth="0.6" aria-hidden="true"><div class="light light2"></div></div>
<div class="lights" data-depth="0.3" aria-hidden="true"><div class="light light3"></div></div>
<div class="lights" data-depth="0.5" aria-hidden="true"><div class="light light4"></div></div>

<script>
  const layers = Array.from(document.querySelectorAll<HTMLElement>('.lights'));

  if (layers.length) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let raf = 0;

    window.addEventListener(
      'pointermove',
      (e) => {
        targetX = (e.clientX / window.innerWidth - 0.5) * 2;
        targetY = (e.clientY / window.innerHeight - 0.5) * 2;
      },
      { passive: true }
    );

    // 鼠标离开窗口时回中
    window.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
    });

    function tick() {
      raf = requestAnimationFrame(tick);
      x += (targetX - x) * 0.045;
      y += (targetY - y) * 0.045;

      for (const el of layers) {
        const depth = Number(el.dataset.depth) || 0.2;
        const tx = (x * 22 * depth).toFixed(2);
        const ty = (y * 22 * depth).toFixed(2);
        el.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
      }
    }

    if (!reduce.matches) raf = requestAnimationFrame(tick);

    reduce.addEventListener('change', () => {
      cancelAnimationFrame(raf);
      if (!reduce.matches) raf = requestAnimationFrame(tick);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(raf);
      } else if (!reduce.matches) {
        raf = requestAnimationFrame(tick);
      }
    });
  }
</script>
