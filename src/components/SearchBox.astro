---
import { url } from '../lib/url';
---

<div class="search" id="site-search" data-index={url('/search.json')}>
  <svg
    class="search-icon"
    viewBox="0 0 24 24"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="10.5" cy="10.5" r="6.5" />
    <path d="m15.3 15.3 4.2 4.2" />
  </svg>

  <input
    type="search"
    id="site-search-input"
    placeholder="搜索文章"
    autocomplete="off"
    spellcheck="false"
    aria-label="搜索文章"
    aria-expanded="false"
    aria-controls="site-search-results"
  />

  <kbd class="search-kbd" aria-hidden="true">/</kbd>

  <div class="search-results" id="site-search-results" hidden></div>
</div>

<script>
  type Item = { t: string; d: string; g: string[]; u: string; y: string };

  const root = document.getElementById('site-search');
  const input = document.getElementById('site-search-input') as HTMLInputElement | null;
  const panel = document.getElementById('site-search-results');

  if (root && input && panel) {
    const endpoint = root.dataset.index ?? '/search.json';

    let items: Item[] = [];
    let loaded = false;
    let pendingLoad: Promise<void> | null = null;
    let active = -1;

    // 并发调用共享同一个请求，await 之后 items 一定已经有值
    const load = (): Promise<void> => {
      if (loaded) return Promise.resolve();
      if (!pendingLoad) {
        pendingLoad = fetch(endpoint)
          .then((res) => res.json() as Promise<Item[]>)
          .then((data) => {
            items = data;
            loaded = true;
          })
          .catch(() => {
            items = [];
            loaded = true;
          })
          .finally(() => {
            pendingLoad = null;
          });
      }
      return pendingLoad;
    };

    const escape = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c
      );

    const highlight = (text: string, q: string) => {
      const safe = escape(text);
      if (!q) return safe;
      const idx = safe.toLowerCase().indexOf(q.toLowerCase());
      if (idx < 0) return safe;
      return (
        safe.slice(0, idx) +
        '<mark>' +
        safe.slice(idx, idx + q.length) +
        '</mark>' +
        safe.slice(idx + q.length)
      );
    };

    const close = () => {
      panel.hidden = true;
      panel.innerHTML = '';
      active = -1;
      input.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const render = (q: string) => {
      const query = q.trim();

      if (!query) {
        close();
        return;
      }

      const needle = query.toLowerCase();
      const hits = items
        .filter((it) => {
          return (
            it.t.toLowerCase().includes(needle) ||
            it.d.toLowerCase().includes(needle) ||
            it.g.some((tag) => tag.toLowerCase().includes(needle)) ||
            it.y.includes(needle)
          );
        })
        .slice(0, 8);

      open();
      active = -1;

      if (!hits.length) {
        panel.innerHTML = `<p class="search-empty">没有匹配「${escape(query)}」的文章</p>`;
        return;
      }

      panel.innerHTML = hits
        .map(
          (it, i) => `
          <a class="search-hit" href="${it.u}" data-i="${i}">
            <span class="hit-title">${highlight(it.t, query)}</span>
            <span class="hit-meta">${it.y}${
              it.g.length ? ' · ' + escape(it.g.join(' / ')) : ''
            }</span>
          </a>`
        )
        .join('');
    };

    const setActive = (next: number) => {
      const nodes = Array.from(panel.querySelectorAll<HTMLAnchorElement>('.search-hit'));
      if (!nodes.length) return;
      active = (next + nodes.length) % nodes.length;
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === active));
      nodes[active].scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('focus', load);
    input.addEventListener('input', async () => {
      const q = input.value;
      await load();
      // 输入期间又被改过就别用旧结果覆盖
      if (input.value === q) render(q);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter') {
        const target =
          panel.querySelector<HTMLAnchorElement>('.search-hit.is-active') ??
          panel.querySelector<HTMLAnchorElement>('.search-hit');
        if (target) {
          e.preventDefault();
          window.location.href = target.href;
        }
      } else if (e.key === 'Escape') {
        input.value = '';
        close();
        input.blur();
      }
    });

    panel.addEventListener('mousemove', (e) => {
      const hit = (e.target as HTMLElement).closest<HTMLAnchorElement>('.search-hit');
      if (hit) setActive(Number(hit.dataset.i));
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    // 按 "/" 快速聚焦
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName;
      const typing =
        tag === 'INPUT' || tag === 'TEXTAREA' || (e.target as HTMLElement)?.isContentEditable;
      if (e.key === '/' && !typing) {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });
  }
</script>
