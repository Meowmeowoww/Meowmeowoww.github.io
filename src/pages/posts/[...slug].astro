---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { formatDate } from '../../lib/format';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tags = post.data.tags ?? [];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base
  wide
  title={post.data.title}
  description={post.data.description}
  type="article"
  current="posts"
>
  <div class:list={['post-grid', toc.length < 2 && 'post-grid-plain']}>
    <article>
      <p class="back"><a href={url('/')}>← 全部文章</a></p>

      <header class="post-header">
        <h1>{post.data.title}</h1>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <span>更新于 {formatDate(post.data.updatedDate)}</span>
            )
          }
          {
            tags.length > 0 && (
              <div class="post-tags">
                {tags.map((tag) => (
                  <a class="tag" href={url(`/tags/${tag}/`)}>
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <Comments />
    </article>

    {
      toc.length >= 2 && (
        <aside class="toc">
          <p class="toc-title">本页内容</p>
          <ul>
            {toc.map((h) => (
              <li class:list={['toc-item', `depth-${h.depth}`]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // 开了页面转场后，导航时 DOM 会重建，所以每次 page-load 都要重新绑定
  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
    const heads = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => Boolean(el));

    if (!heads.length || !('IntersectionObserver' in window)) return;

    const setActive = (id: string) => {
      for (const a of links) {
        a.classList.toggle('is-active', a.hash === `#${id}`);
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-10% 0px -70% 0px', threshold: [0, 1] }
    );

    for (const h of heads) io.observe(h);
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
