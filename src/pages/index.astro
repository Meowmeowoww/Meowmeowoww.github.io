---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { formatDate } from '../lib/format';
import { url } from '../lib/url';

const posts = (
  await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base current="home">
  {
    posts.length === 0 ? (
      <p class="empty">
        还没有文章。往 <code>src/content/posts/</code> 里放一个 .md 文件就会出现在这里。
      </p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <h2>
              <a href={url(`/posts/${post.id}/`)}>{post.data.title}</a>
            </h2>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        ))}
      </ul>
    )
  }

  <section class="social-row">
    <a class="social-pill" href={SITE.bilibili} rel="me">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="7" width="18" height="13" rx="3" />
        <path d="m8 3 3 4M16 3l-3 4M8.5 13.5h.01M15.5 13.5h.01" />
      </svg>
      B 站
    </a>
    <a class="social-pill" href={SITE.douyin} rel="me">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 4v9.5a3.5 3.5 0 1 1-3-3.46" />
        <path d="M15 4c.4 2.2 1.9 3.7 4 4" />
      </svg>
      抖音
    </a>
    <a class="social-pill" href={`https://github.com/${SITE.github}`}>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 19c-4 1.2-4-2.2-5.5-2.7M15 21v-3.4c0-1 .1-1.4-.5-2 2.3-.3 4.5-1.2 4.5-5a4 4 0 0 0-1.1-2.8c.1-.3.5-1.4-.1-2.8 0 0-1-.3-3.3 1.2a11 11 0 0 0-5.8 0C6.2 4.7 5.2 5 5.2 5c-.6 1.4-.2 2.5-.1 2.8A4 4 0 0 0 4 10.6c0 3.8 2.2 4.7 4.5 5-.6.6-.6 1.2-.5 2V21" />
      </svg>
      GitHub
    </a>
  </section>
</Base>
